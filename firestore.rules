rules_version = '2';

// =============================================================================
// GiraSun — Firestore security rules v1
// =============================================================================
//
// Default deny. Only the paths explicitly allowlisted below permit access.
// All admin writes (subscribers, admins, newsletter_sends) go through the
// Next.js server using the Admin SDK, which bypasses these rules entirely —
// these rules only govern client-side reads/writes from authenticated users.
//
// Tested in src/lib/firebase/__tests__/rules.test.ts via the
// @firebase/rules-unit-testing package against the local emulator.

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function shapeOf(map, requiredKeys, optionalKeys) {
      // every required key must be present and only required+optional keys allowed
      return map.keys().hasAll(requiredKeys) &&
             map.keys().hasOnly(requiredKeys.concat(optionalKeys));
    }

    function nonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // -------------------------------------------------------------------------
    // /comments/{commentId}
    //   read:   anyone — but only documents where hidden == false. (Filtering
    //           on the read with .where("hidden", "==", false) is enforced by
    //           the queries we make in app code; the rules ensure the
    //           individual doc read still works for hidden=false.)
    //   create: signed-in user, with a valid shape, hidden defaults to false.
    //   update: only admin (to set hidden=true).
    //   delete: only admin.
    // -------------------------------------------------------------------------
    match /comments/{commentId} {
      allow read: if resource.data.hidden == false || isAdmin();

      allow create: if isSignedIn()
        && shapeOf(request.resource.data,
            ["postType", "postSlug", "uid", "authorName", "body", "createdAt"],
            ["authorPhotoURL", "hidden"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postType in ["cuento", "escrito"]
        && nonEmptyString(request.resource.data.postSlug, 200)
        && nonEmptyString(request.resource.data.authorName, 80)
        && nonEmptyString(request.resource.data.body, 4000)
        && (!("hidden" in request.resource.data.keys()) || request.resource.data.hidden == false)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // /likes/{likeId}
    //   read:   anyone. Like counts are public.
    //   create: signed-in user, exactly one like per (postType, postSlug, uid).
    //           Doc id is enforced as `${postType}_${postSlug}_${uid}` so a
    //           second create from the same user collides naturally.
    //   delete: the user who created the like, or admin (to undo).
    //   update: never (likes are atomic — to "unlike" you delete).
    // -------------------------------------------------------------------------
    match /likes/{likeId} {
      allow read: if true;

      allow create: if isSignedIn()
        && shapeOf(request.resource.data,
            ["postType", "postSlug", "uid", "createdAt"],
            [])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postType in ["cuento", "escrito"]
        && nonEmptyString(request.resource.data.postSlug, 200)
        && likeId == request.resource.data.postType + "_" +
                     request.resource.data.postSlug + "_" +
                     request.resource.data.uid
        && request.resource.data.createdAt == request.time;

      allow delete: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());

      allow update: if false;
    }

    // -------------------------------------------------------------------------
    // /admins/{email}
    //   Doc id is the lowercased Google account email. Existence of the doc
    //   means that email is on the admin allowlist.
    //   Client access denied entirely. Bootstrap and changes via Admin SDK
    //   from the /admin/configuracion route (Phase 9).
    // -------------------------------------------------------------------------
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /subscribers/{token}
    //   Newsletter subscriptions. Client write denied — the public form
    //   submits to a Next.js server action which uses the Admin SDK after
    //   Zod validation + reCAPTCHA verification.
    // -------------------------------------------------------------------------
    match /subscribers/{token} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /newsletter_sends/{sendId}
    //   Audit trail of newsletter sends. Admin SDK writes only.
    // -------------------------------------------------------------------------
    match /newsletter_sends/{sendId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /settings/{settingId}
    //   Site-wide editable content (about-home, about-page). Public read;
    //   writes only via the Admin SDK from server actions (bypasses rules).
    // -------------------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /rateLimits/{key}
    //   App-side rate limiter. Admin SDK only.
    // -------------------------------------------------------------------------
    match /rateLimits/{key} {
      allow read, write: if false;
    }
  }
}
