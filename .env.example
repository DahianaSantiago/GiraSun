# =============================================================================
# GiraSun environment variables.
# Copy this file to .env.local and fill in real values for local dev.
# In Vercel, set the same vars under Project Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase — public client config (Phase 4)
# Safe to commit as examples; the API key is not a secret (only the Firestore
# rules + App Check + auth domain restrictions protect the project).
# Get these from: Firebase console → Project Settings → General → Your apps → Web
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to 1 in .env.local (NEVER in production) to point Auth + Firestore at
# the local emulator suite started by `pnpm firebase:emulators`.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# -----------------------------------------------------------------------------
# Firebase — Admin SDK (server only, NEVER commit, NEVER expose to the browser)
# Get these from: Firebase console → Project Settings → Service accounts →
# Generate new private key → use the project_id, client_email, and private_key
# fields from the downloaded JSON.
#
# IMPORTANT: when pasting FIREBASE_ADMIN_PRIVATE_KEY into Vercel, keep the
# `\n` escapes intact (don't replace them with real newlines). The server-side
# init replaces them at runtime.
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Admin allowlist (Phase 7)
# Comma-separated list of emails that bootstrap as admins. Extra admins can
# be added via the admin Configuración page once you have at least one.
# -----------------------------------------------------------------------------
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Canonical site URL — metadata, og:image, sitemap, robots and email links.
# Defaults to https://www.girasun.com (the host the deployment answers on).
# Set it to https://girasun.com once the apex resolves to Vercel by itself.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# Resend — newsletter sending (Phase 6)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# -----------------------------------------------------------------------------
# GitHub — admin publish flow (Phase 8)
# Fine-grained PAT with Contents:Write on the GiraSun repo. The admin
# 'Publicar' button uses this to commit MDX directly.
# Phase 10 swaps this for a GitHub App for proper attribution.
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO_OWNER=DahianaSantiago
GITHUB_REPO_NAME=GiraSun
GITHUB_DEFAULT_BRANCH=main

# -----------------------------------------------------------------------------
# Upstash Redis — rate limiter (Phase 10)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# reCAPTCHA — newsletter signup + App Check (Phase 10)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
