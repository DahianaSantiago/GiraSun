{
  "name": "girasun",
  "version": "0.1.0",
  "private": true,
  "description": "GiraSun — diario literario de Dahiana Santiago. Cuentos, escritos, club de lectura y CineClub.",
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/setup-hooks.mjs",
    "firebase:emulators": "firebase emulators:start --only auth,firestore",
    "firebase:rules:deploy": "firebase deploy --only firestore:rules",
    "firebase:indexes:deploy": "firebase deploy --only firestore:indexes"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@octokit/rest": "^22.0.1",
    "@react-email/components": "^1.0.12",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "browser-image-compression": "^2.0.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.8.0",
    "gray-matter": "^4.0.3",
    "next": "16.2.5",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^5.5.7",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.3",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "firebase-tools": "^15.17.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "simple-git-hooks": "^2.11.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,mdx,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
